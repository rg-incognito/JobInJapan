{
  "manifest_version": 3,
  "name": "JobFill",
  "version": "1.0.0",
  "description": "Autofills job applications from Rohit's JobInJapan profile. Never ticks consents, never submits.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "*://*.naukri.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "JobFill"},
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://jobs.lever.co/*", "*://jobs.eu.lever.co/*",
        "*://jobs.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.myworkdayjobs.com/*", "*://*.myworkdaysite.com/*",
        "*://*.workable.com/*",
        "*://*.recruitee.com/*",
        "*://*.personio.de/*", "*://*.personio.com/*",
        "*://*.teamtailor.com/*",
        "*://*.bamboohr.com/*",
        "*://*.join.com/*",
        "*://*.breezy.hr/*",
        "*://*.jobvite.com/*",
        "*://*.icims.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.naukri.com/*"],
      "js": ["naukri.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
